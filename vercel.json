{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)scripts' ':(exclude).github' ':(exclude)*.md' ':(exclude)*.py'",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/backup.js": {
      "maxDuration": 300
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth/login",
      "destination": "/api/auth?action=login"
    },
    {
      "source": "/demo",
      "destination": "/api/auth?action=demo"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/auth?action=callback"
    },
    {
      "source": "/auth/logout",
      "destination": "/api/auth?action=logout"
    },
    {
      "source": "/j/:code",
      "destination": "/join.html?c=:code"
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 18 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ]
}
